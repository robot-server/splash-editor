build/
build-*/
.cache/
.DS_Store
compile_commands.json
CMakeUserPresets.json

# 테스트 맵은 저작권 자료이므로 커밋하지 않는다 (tests/maps/README.md 참고)
tests/maps/*.scm
tests/maps/*.scx
tests/maps/*.chk

# 파이썬 캐시
__pycache__/

# 학습에 쓴 원본 맵은 저장소 어디에도 넣지 않는다. 제작에 재사용할
# 규칙은 출처 맥락과 기능 패턴을 docs/에 기록한다.
*.scm
*.scx
*.chk
*.mpq
*.trig.tmp
*.tiles
*.objects

# 로컬 원본 학습 자료: 저작권 원본 맵과 강좌 덤프는 커밋하지 않는다.
_local-corpus/**
!_local-corpus/.gitkeep
